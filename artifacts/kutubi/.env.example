# Public browser configuration. These values can be exposed in a Vite build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Keep secrets such as SUPABASE_SERVICE_ROLE_KEY only in the server host's
# secret manager. Never prefix a service-role key with VITE_.
